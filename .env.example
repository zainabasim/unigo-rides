# PostgreSQL Database (Neon.tech)
# Get this from your Neon.tech dashboard
DATABASE_URL=postgresql://username:password@hostname:5432/database?sslmode=require

# Supabase Configuration (Legacy - can be removed after migration)
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANONYMOUS_KEY=your-anon-key-here

# Note: Make sure to copy this file to .env and fill in your actual values
